// Windows resources for Phoenix.exe: the icon Explorer, the taskbar and
// the installer's shortcuts show, and the version Explorer lists.
// Configured by CMakeLists.txt.

#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/phoenix.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PHOENIX_VERSION_MAJOR@,@PHOENIX_VERSION_MINOR@,@PHOENIX_VERSION_PATCH@,0
PRODUCTVERSION  @PHOENIX_VERSION_MAJOR@,@PHOENIX_VERSION_MINOR@,@PHOENIX_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Phoenix"
            VALUE "FileVersion", "@PHOENIX_VERSION@"
            VALUE "ProductName", "Phoenix"
            VALUE "ProductVersion", "@PHOENIX_VERSION@"
            VALUE "OriginalFilename", "Phoenix.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
