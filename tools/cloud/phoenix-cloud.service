# Phoenix Cloud as a systemd service. tools/cloud/setup_server.sh installs it
# as /etc/systemd/system/phoenix-cloud.service; tools/deploy_cloud.py puts
# releases in /opt/phoenix-cloud/releases and points current at the newest.

[Unit]
Description=Phoenix Cloud
After=network-online.target
Wants=network-online.target

[Service]
User=phoenix-cloud
Group=phoenix-cloud
EnvironmentFile=/etc/phoenix-cloud.env
Environment=PHOENIX_CLOUD_MODE=production
WorkingDirectory=/opt/phoenix-cloud/current/cloud
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /opt/phoenix-cloud/current/cloud/server.mjs serve
Restart=on-failure
RestartSec=3

# It reads its release and writes only its data folder.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/phoenix-cloud
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
